# AuditOS — environment template. Copy to `.env` (which is gitignored) and fill in.
# Keys are read ONLY inside engine/llm/ (SPEC §4/§5). Never hard-code them elsewhere.

# ── LLM providers ──────────────────────────────────────────────────────────
# Anthropic Claude is PRIMARY. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI is the fallback / second-opinion provider (optional).
OPENAI_API_KEY=

# ── Model selection (optional — sensible defaults live in engine/llm/) ──────
# Primary model for protocol synthesis + agents.
AUDITOS_PRIMARY_MODEL=claude-opus-4-8
# Fallback model.
AUDITOS_FALLBACK_MODEL=gpt-4o

# ── Server ─────────────────────────────────────────────────────────────────
AUDITOS_API_HOST=127.0.0.1
AUDITOS_API_PORT=8000

# ── Run storage ────────────────────────────────────────────────────────────
# Where per-run temp dirs + the JSON artifact cache live (SPEC §4 storage).
AUDITOS_RUN_DIR=./run
